# ─────────────────────────────────────────────────────────────
# BayOne Snowflake Query Agent — environment
# Copy to ".env" and fill in real values. NEVER commit .env.
# Auth: set EXACTLY ONE of SNOWFLAKE_PASSWORD or SNOWFLAKE_PRIVATE_KEY_PATH.
# Note: Snowflake is deprecating single-factor password auth (~Oct 2026);
# key-pair is the service-account standard for unattended use.
# ─────────────────────────────────────────────────────────────

# Snowflake account locator, e.g. "abcd-xy12345" (org-account or legacy form).
SNOWFLAKE_ACCOUNT=

# Snowflake user the agent connects as.
SNOWFLAKE_USER=

# ── Auth option A: password ──
SNOWFLAKE_PASSWORD=

# ── Auth option B: key-pair (leave blank if using password) ──
# Absolute path to the PEM private key registered on the user.
# Generate: openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PATH=

# Passphrase for the private key. Leave blank if the key is unencrypted.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Warehouse / database / schema / role the agent runs under.
# ROLE MUST BE READ-ONLY (SELECT on the target schema, no write/DDL).
# After running docs/sql/ (per-owner private-data migration), set this to BAYI_READ.
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# ── Optional tuning ──
# Max rows fed back to the model per query before truncation. Default 200.
# Lower = fewer tokens (each row is re-sent across the agent loop's rounds);
# raise it if you need very long verbatim lists.
SF_ROW_CAP=200

# ── Cortex Analyst (chunk 3a) ──
# Programmatic Access Token for the Cortex Analyst REST API (separate from the
# SQL connection's password/key-pair). Generate under the user's security settings.
SNOWFLAKE_PAT=
# Fully-qualified semantic view Cortex Analyst reasons over.
CORTEX_SEMANTIC_VIEW=BAYONE_INTERNALINFO.PUBLIC.BILLABLE_SEMANTIC
# REST round-trip timeout in seconds. Default 60.
CORTEX_TIMEOUT_S=60

# ── Agent loop (chunk 2) ──
ANTHROPIC_API_KEY=
# Model for the agent loop. Default: claude-sonnet-4-6.
AGENT_MODEL=claude-sonnet-4-6
# Max SQL query rounds before the model must answer. Default: 8.
AGENT_MAX_ROUNDS=8
# Max output tokens per model turn. Default: 8192. Large enough that list answers
# (e.g. "names of all consultants who...") serialize as complete JSON rather than
# truncating mid-object.
AGENT_MAX_TOKENS=8192

# ── Ingest page (structure → confirm → load) ──
# The ingest load path uses a SEPARATE, write-capable Snowflake connection so the
# query connection above can stay strictly read-only. It reuses SNOWFLAKE_ACCOUNT /
# SNOWFLAKE_USER and the same auth (password or key-pair) as the read connection,
# but with its own role / database / schema below. Leave these blank to disable the
# commit step (structuring still works; the Confirm button reports it's unavailable).
# The ingest ROLE should be the ONLY write-capable role (that is the security
# boundary — NOT the schema). After running docs/sql/, set this to BAYI_INGEST_WRITE.
SNOWFLAKE_INGEST_ROLE=
# Database / schema fall back to SNOWFLAKE_DATABASE / SNOWFLAKE_SCHEMA when blank.
# IMPORTANT: ingest must write into the SAME schema the query agent reads, or ingested
# blocks/facts are invisible to queries. Leave SNOWFLAKE_INGEST_SCHEMA blank to inherit
# SNOWFLAKE_SCHEMA; only set it if it equals the query schema.
SNOWFLAKE_INGEST_DATABASE=
SNOWFLAKE_INGEST_SCHEMA=
# Optional: separate compute for writes. Falls back to SNOWFLAKE_WAREHOUSE if unset.
SNOWFLAKE_INGEST_WAREHOUSE=

# ── Per-owner private-data enforcement (docs/security-model.html) ──
# Users can mark an upload "private": its rows are stamped with their identity and a
# Snowflake row-access policy shows them only to that owner (plus a break-glass admin).
# ALL DEFAULTS BELOW PRESERVE TODAY'S BEHAVIOR — leave ENFORCE_OWNERSHIP false until the
# docs/sql/ migration (roles + columns + rap_ownership policy) has been applied.
#
# Master switch. true = bind caller identity per query + require auth on /api/ask.
ENFORCE_OWNERSHIP=false
# Snowflake session variable the app sets to the caller's identity. MUST match the
# variable name in docs/sql/03_row_access_policy.sql. Default: BAYI_CALLER.
CALLER_SESSION_VAR=BAYI_CALLER
# Header Azure App Service "Easy Auth" injects with the signed-in user's identity.
EASY_AUTH_HEADER=X-MS-CLIENT-PRINCIPAL-NAME
# Local dev fallback identity used when the Easy Auth header is absent (no Azure).
# Set to an email to test private ingest / owner-scoped queries locally.
DEV_CALLER_IDENTITY=

# ── Protected (group-scoped) tier ──
# A third tier above private: only members of ONE privileged Entra/M365 group may mark
# an upload "protected", and only that group can read/query protected rows. On the
# company SharePoint deployment, membership comes from the caller's group claim.
# The single privileged group name (the old SG-BayI-Sensitive).
PROTECTED_GROUP=SG-BayI-Sensitive
# Server-trusted header carrying the caller's group memberships (comma-separated). The
# SharePoint/M365 deployment maps the Entra groups claim onto this header; the browser
# cannot set it. Keep configurable to match whatever the host surfaces.
GROUPS_HEADER=X-MS-CLIENT-GROUPS
# Snowflake session variable set to 'true'/'false' per query so the row-access policy
# knows if the caller is in PROTECTED_GROUP. MUST match docs/sql/03_row_access_policy.sql.
PROTECTED_SESSION_VAR=BAYI_PROTECTED
# Local dev fallback group list (comma-separated) used when GROUPS_HEADER is absent.
# Include PROTECTED_GROUP to test protected ingest / group-scoped queries locally.
DEV_CALLER_GROUPS=

# Max output tokens for the one-shot structuring call. Default: 64000 (model max).
# Structuring emits one large JSON object (blocks + facts); a lower ceiling truncates
# rich documents into invalid JSON, so this is set to the model's full output budget.
INGEST_MAX_TOKENS=64000
