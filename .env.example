# ─────────────────────────────────────────────────────────────
# BayOne Snowflake Query Agent — environment
# Copy to ".env" and fill in real values. NEVER commit .env.
# Auth: set EXACTLY ONE of SNOWFLAKE_PASSWORD or SNOWFLAKE_PRIVATE_KEY_PATH.
# Note: Snowflake is deprecating single-factor password auth (~Oct 2026);
# key-pair is the service-account standard for unattended use.
# ─────────────────────────────────────────────────────────────

# Snowflake account locator, e.g. "abcd-xy12345" (org-account or legacy form).
SNOWFLAKE_ACCOUNT=

# Snowflake user the agent connects as.
SNOWFLAKE_USER=

# ── Auth option A: password ──
SNOWFLAKE_PASSWORD=

# ── Auth option B: key-pair (leave blank if using password) ──
# Absolute path to the PEM private key registered on the user.
# Generate: openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PATH=

# Passphrase for the private key. Leave blank if the key is unencrypted.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Warehouse / database / schema / role the agent runs under.
# ROLE MUST BE READ-ONLY (SELECT on the target schema, no write/DDL).
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# ── Optional tuning ──
# Max rows returned to the caller before truncation. Default 1000.
SF_ROW_CAP=1000

# ── Cortex Analyst (chunk 3a) ──
# Programmatic Access Token for the Cortex Analyst REST API (separate from the
# SQL connection's password/key-pair). Generate under the user's security settings.
SNOWFLAKE_PAT=
# Fully-qualified semantic view Cortex Analyst reasons over.
CORTEX_SEMANTIC_VIEW=BAYONE_INTERNALINFO.PUBLIC.BILLABLE_SEMANTIC
# REST round-trip timeout in seconds. Default 60.
CORTEX_TIMEOUT_S=60

# ── Agent loop (chunk 2) ──
ANTHROPIC_API_KEY=
# Model for the agent loop. Default: claude-sonnet-4-6.
AGENT_MODEL=claude-sonnet-4-6
# Max SQL query rounds before the model must answer. Default: 8.
AGENT_MAX_ROUNDS=8
# Max output tokens per model turn. Default: 8192. Large enough that list answers
# (e.g. "names of all consultants who...") serialize as complete JSON rather than
# truncating mid-object.
AGENT_MAX_TOKENS=8192
